# Copy to /home/oral/f-doc/.env.prod on the server and replace all placeholders.
APP_URL=http://100.75.51.122:3000
PORT=3000
APP_SECRET=REPLACE_WITH_openssl_rand_hex_32

POSTGRES_DB=f-doc
POSTGRES_USER=f-doc
